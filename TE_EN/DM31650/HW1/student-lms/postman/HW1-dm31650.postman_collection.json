{
  "info": {
    "name": "HW1 - Durim Memishi - dm31650",
    "_postman_id": "b4553903-b0a6-4919-b4ba-f3a0f7ba756e",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Student LMS HW1: run in order on a local server. The POST saves studentId automatically. Includes persistence verification after PUT and DELETE."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3005"
    },
    {
      "key": "studentId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - POST create student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/student",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "student"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Durim Memishi\",\n  \"email\": \"dm31650@example.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP 201', () => pm.response.to.have.status(201));",
              "const student = pm.response.json();",
              "pm.collectionVariables.set('studentId', student.id);",
              "pm.test('Created Durim Memishi', () => pm.expect(student.name).to.eql('Durim Memishi'));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - GET all students",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/students",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "students"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('New student is in the list', () => pm.expect(pm.response.json().some(s => s.id === Number(pm.collectionVariables.get('studentId')))).to.be.true);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - GET student by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/students/{{studentId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "students",
            "{{studentId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Correct student', () => pm.expect(pm.response.json().email).to.eql('dm31650@example.com'));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - PUT update student",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/students/{{studentId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "students",
            "{{studentId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Durim Memishi (Updated)\",\n  \"email\": \"dm31650.updated@example.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Updated student returned', () => pm.expect(pm.response.json().email).to.eql('dm31650.updated@example.com'));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - GET verify persisted update",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/students/{{studentId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "students",
            "{{studentId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Update persisted', () => pm.expect(pm.response.json().name).to.eql('Durim Memishi (Updated)'));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - DELETE student",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/students/{{studentId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "students",
            "{{studentId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Deletion confirmed', () => pm.expect(pm.response.json().message).to.eql('Student deleted successfully'));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - GET verify deletion",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/students/{{studentId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "students",
            "{{studentId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP 404', () => pm.response.to.have.status(404));",
              "pm.test('Deleted student is absent', () => pm.expect(pm.response.json().error).to.eql('Student not found'));"
            ]
          }
        }
      ]
    }
  ]
}
